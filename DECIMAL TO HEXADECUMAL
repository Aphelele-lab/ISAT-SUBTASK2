def hexadecimal_to_decimal(hexadecimal):
    hexadecimal = hexadecimal.upper()
    hexadecimal_digits = "0123456789ABCDEF"

    decimal = 0

    for digit in hexadecimal:
        value = hexadecimal_digits.index(digit)
        decimal = decimal * 16 + value

    return decimal


